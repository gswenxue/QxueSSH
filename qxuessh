#!/usr/bin/env bash
# ============================================================
# QxueSSH 服务管理工具（交互式菜单）
# 用法: qxuessh          —— 唤起菜单
#       qxuessh <命令>   —— 也支持直接命令（status/port/restart等）
# ============================================================

INSTALL_DIR="/opt/QxueSSH"
NODE_DIR="/opt/qxue-node"
SERVICE_NAME="qxuessh"
DB_FILE="$INSTALL_DIR/data/db.json"

# 确保终端环境可用
export TERM=xterm-256color

# 固定使用脚本安装的 Node.js（独立目录，不依赖系统预装）
NODE_BIN="$NODE_DIR/bin/node"
[ ! -x "$NODE_BIN" ] && NODE_BIN=$(which node 2>/dev/null || echo "node")

# 检测服务管理类型（systemd / openrc / nohup）
detect_service_manager() {
  if command -v systemctl &>/dev/null; then
    SERVICE_MANAGER="systemd"
  elif command -v rc-service &>/dev/null; then
    SERVICE_MANAGER="openrc"
  else
    SERVICE_MANAGER="nohup"
  fi
}
detect_service_manager

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'
DIM=$'\033[2m'

# ---------- 状态检测 ----------
get_status() {
  if [ "$SERVICE_MANAGER" = "systemd" ] && systemctl is-active --quiet $SERVICE_NAME 2>/dev/null; then
    RUNNING=1
    STATUS_TEXT="${GREEN}● 运行中${NC}"
  elif [ "$SERVICE_MANAGER" = "openrc" ] && rc-service $SERVICE_NAME status &>/dev/null; then
    RUNNING=1
    STATUS_TEXT="${GREEN}● 运行中${NC}"
  elif pgrep -f "node server.js" >/dev/null 2>&1; then
    RUNNING=1
    STATUS_TEXT="${GREEN}● 运行中${NC}"
  else
    RUNNING=0
    STATUS_TEXT="${RED}● 未运行${NC}"
  fi
}

get_port() {
  PORT=$(ss -tlnp 2>/dev/null | grep "node" | awk '{print $4}' | grep -oP '\d+$' | head -1)
  [ -z "$PORT" ] && PORT=$(grep -oP 'Environment=PORT=\K\d+' /etc/systemd/system/${SERVICE_NAME}.service 2>/dev/null)
  [ -z "$PORT" ] && PORT=$(grep -oP 'env PORT="\K\d+' /etc/init.d/${SERVICE_NAME} 2>/dev/null)
  [ -z "$PORT" ] && PORT="--"
}

get_autostart() {
  if [ "$SERVICE_MANAGER" = "systemd" ] && systemctl is-enabled --quiet $SERVICE_NAME 2>/dev/null; then
    AUTOSTART_TEXT="${GREEN}已开启${NC}"
  elif [ "$SERVICE_MANAGER" = "openrc" ] && rc-update show 2>/dev/null | grep -q "$SERVICE_NAME"; then
    AUTOSTART_TEXT="${GREEN}已开启${NC}"
  else
    AUTOSTART_TEXT="${DIM}未开启${NC}"
  fi
}

refresh_status() {
  get_status
  get_port
  get_autostart
}

# ---------- 可见宽度计算（去掉ANSI码，中文字符算2列） ----------
viswidth() {
  local s=$(echo -n "$1" | sed 's/\x1b\[[0-9;]*m//g')
  local w=0 i c
  for ((i=0; i<${#s}; i++)); do
    c="${s:$i:1}"
    if [[ "$c" =~ [一-鿿] ]]; then w=$((w+2)); else w=$((w+1)); fi
  done
  echo $w
}

# ---------- 菜单绘制（简洁样式，无框线） ----------
draw_menu() {
  refresh_status
  clear 2>/dev/null || printf '\033[2J\033[H'
  echo ""
  echo -e "${BOLD}${BLUE}===== QxueSSH 服务管理 =====${NC}"
  echo -e "  状态: $STATUS_TEXT   端口: ${CYAN}$PORT${NC}   自启: $AUTOSTART_TEXT"
  echo -e "${BLUE}----------------------------${NC}"
  echo -e "  ${DIM}1${NC}. 重启服务"
  echo -e "  ${DIM}2${NC}. 停止服务"
  echo -e "  ${DIM}3${NC}. 启动服务"
  echo -e "  ${DIM}4${NC}. 修改运行端口"
  echo -e "  ${DIM}5${NC}. 开机自启动管理"
  echo -e "  ${DIM}6${NC}. 重置管理员密码"
  echo -e "  ${DIM}7${NC}. 查看运行日志"
  echo -e "  ${DIM}8${NC}. 查看服务详情"
  echo -e "  ${DIM}9${NC}. 卸载服务"
  echo -e "${BLUE}----------------------------${NC}"
  echo -e "  ${DIM}0${NC}. 退出"
  echo ""
}

pause() {
  echo ""
  read -rp "按回车键返回菜单..." _
}

# ---------- 操作函数 ----------
do_restart() {
  echo -e "${CYAN}正在重启服务...${NC}"
  case "$SERVICE_MANAGER" in
    systemd) systemctl restart $SERVICE_NAME && echo -e "${GREEN}✓ 服务已重启${NC}" ;;
    openrc)  rc-service $SERVICE_NAME restart && echo -e "${GREEN}✓ 服务已重启${NC}" ;;
    *)       pkill -f "node server.js" 2>/dev/null; sleep 1; cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 & echo -e "${GREEN}✓ 服务已重启${NC}" ;;
  esac
  pause
}

do_stop() {
  if [ "$RUNNING" -eq 0 ]; then
    echo -e "${YELLOW}服务当前未运行${NC}"
    pause; return
  fi
  echo -e "${CYAN}正在停止服务...${NC}"
  case "$SERVICE_MANAGER" in
    systemd) systemctl stop $SERVICE_NAME && echo -e "${GREEN}✓ 服务已停止${NC}" ;;
    openrc)  rc-service $SERVICE_NAME stop && echo -e "${GREEN}✓ 服务已停止${NC}" ;;
    *)       pkill -f "node server.js" && echo -e "${GREEN}✓ 服务已停止${NC}" ;;
  esac
  pause
}

do_start() {
  if [ "$RUNNING" -eq 1 ]; then
    echo -e "${YELLOW}服务已在运行中${NC}"
    pause; return
  fi
  echo -e "${CYAN}正在启动服务...${NC}"
  case "$SERVICE_MANAGER" in
    systemd) systemctl start $SERVICE_NAME && echo -e "${GREEN}✓ 服务已启动${NC}" ;;
    openrc)  rc-service $SERVICE_NAME start && echo -e "${GREEN}✓ 服务已启动${NC}" ;;
    *)       cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 & echo -e "${GREEN}✓ 服务已启动${NC}" ;;
  esac
  pause
}

do_port() {
  echo ""
  echo -e "${CYAN}当前端口: $PORT${NC}"
  read -rp "请输入新端口号 (1-65535): " NEW_PORT
  if [ -z "$NEW_PORT" ]; then
    echo -e "${RED}✗ 未输入端口，已取消${NC}"; pause; return
  fi
  if ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
    echo -e "${RED}✗ 无效端口号${NC}"; pause; return
  fi
  if [ "$SERVICE_MANAGER" = "systemd" ]; then
    sed -i "s/^Environment=PORT=.*/Environment=PORT=$NEW_PORT/" /etc/systemd/system/${SERVICE_NAME}.service
    systemctl daemon-reload
    systemctl restart $SERVICE_NAME
    echo -e "${GREEN}✓ 端口已修改为 $NEW_PORT，服务已重启${NC}"
  elif [ "$SERVICE_MANAGER" = "openrc" ]; then
    sed -i "s/^env PORT=.*/env PORT=\"$NEW_PORT\"/" /etc/init.d/${SERVICE_NAME}
    rc-service $SERVICE_NAME restart
    echo -e "${GREEN}✓ 端口已修改为 $NEW_PORT，服务已重启${NC}"
  else
    echo -e "${YELLOW}未使用 systemd 或 OpenRC，请手动修改启动命令中的 PORT 环境变量${NC}"
  fi
  pause
}

do_autostart() {
  echo ""
  echo -e "当前自启动状态: $AUTOSTART_TEXT"
  echo ""
  echo "  1. 开启开机自启动"
  echo "  2. 关闭开机自启动"
  echo "  0. 返回"
  read -rp "请选择 [0-2]: " sub
  case "$sub" in
    1)
      if [ "$SERVICE_MANAGER" = "systemd" ]; then
        systemctl enable $SERVICE_NAME 2>/dev/null && echo -e "${GREEN}✓ 已开启开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}"
      elif [ "$SERVICE_MANAGER" = "openrc" ]; then
        rc-update add $SERVICE_NAME default 2>/dev/null && echo -e "${GREEN}✓ 已开启开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}"
      fi
      ;;
    2)
      if [ "$SERVICE_MANAGER" = "systemd" ]; then
        systemctl disable $SERVICE_NAME 2>/dev/null && echo -e "${GREEN}✓ 已关闭开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}"
      elif [ "$SERVICE_MANAGER" = "openrc" ]; then
        rc-update del $SERVICE_NAME default 2>/dev/null && echo -e "${GREEN}✓ 已关闭开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}"
      fi
      ;;
    *) ;;
  esac
  pause
}

do_resetpass() {
  echo ""
  echo -e "${YELLOW}⚠ 重置管理员密码${NC}"
  echo -e "${DIM}将修改数据库中管理员账号的密码哈希${NC}"
  echo ""
  read -rsp "请输入新密码（至少8位）: " NEW_PASS; echo
  if [ ${#NEW_PASS} -lt 8 ]; then
    echo -e "${RED}✗ 密码至少 8 位${NC}"; pause; return
  fi
  read -rsp "请再次输入确认: " NEW_PASS2; echo
  if [ "$NEW_PASS" != "$NEW_PASS2" ]; then
    echo -e "${RED}✗ 两次输入不一致${NC}"; pause; return
  fi
  cd $INSTALL_DIR
  RESULT=$($NODE_BIN -e "
const fs = require('fs');
const b = require('bcryptjs');
try {
  const db = JSON.parse(fs.readFileSync('$DB_FILE', 'utf8'));
  const admin = db.users.find(u => u.role === 'admin');
  if (!admin) { console.log('FAIL:未找到管理员账号'); process.exit(1); }
  admin.passHash = b.hashSync(process.argv[1], 10);
  fs.writeFileSync('$DB_FILE', JSON.stringify(db, null, 2));
  console.log('OK:' + admin.username);
} catch(e) { console.log('FAIL:' + e.message); process.exit(1); }
" "$NEW_PASS" 2>&1)
  if echo "$RESULT" | grep -q "^OK:"; then
    USERNAME=$(echo "$RESULT" | cut -d: -f2)
    echo -e "${GREEN}✓ 管理员「$USERNAME」密码已重置${NC}"
    echo -e "${DIM}请使用新密码登录${NC}"
  else
    echo -e "${RED}✗ 重置失败: $(echo "$RESULT" | cut -d: -f2)${NC}"
  fi
  pause
}

do_logs() {
  echo ""
  echo -e "${CYAN}最近 50 行日志:${NC}"
  echo -e "${DIM}──────────────────────────────────────${NC}"
  if [ "$SERVICE_MANAGER" = "systemd" ] && command -v journalctl &>/dev/null; then
    journalctl -u $SERVICE_NAME -n 50 --no-pager 2>/dev/null || echo "无日志"
  elif [ "$SERVICE_MANAGER" = "openrc" ]; then
    tail -50 /var/log/qxuessh.log 2>/dev/null || echo "暂无日志"
  else
    tail -50 /tmp/qxuessh.log 2>/dev/null || echo "暂无日志"
  fi
  echo -e "${DIM}──────────────────────────────────────${NC}"
  pause
}

do_detail() {
  echo ""
  if [ "$SERVICE_MANAGER" = "systemd" ]; then
    systemctl status $SERVICE_NAME --no-pager -l 2>/dev/null
  elif [ "$SERVICE_MANAGER" = "openrc" ]; then
    rc-service $SERVICE_NAME status 2>/dev/null
    echo ""
    echo "进程信息:"
    ps aux | grep "node server.js" | grep -v grep
    echo ""
    echo "监听端口:"
    ss -tlnp | grep node
  else
    echo "进程信息:"
    ps aux | grep "node server.js" | grep -v grep
    echo ""
    echo "监听端口:"
    ss -tlnp | grep node
  fi
  pause
}

do_uninstall() {
  echo ""
  echo -e "${RED}⚠ 卸载 QxueSSH${NC}"
  echo -e "${DIM}将停止服务并删除项目文件${NC}"
  echo ""
  read -rp "确认卸载？(y/N): " CONFIRM
  [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ] && { echo -e "${YELLOW}已取消${NC}"; pause; return; }

  echo -e "${CYAN}正在停止服务...${NC}"
  case "$SERVICE_MANAGER" in
    systemd) systemctl stop $SERVICE_NAME 2>/dev/null; systemctl disable $SERVICE_NAME 2>/dev/null ;;
    openrc)  rc-service $SERVICE_NAME stop 2>/dev/null; rc-update del $SERVICE_NAME default 2>/dev/null ;;
  esac
  pkill -f "node server.js" 2>/dev/null

  echo ""
  read -rp "是否保留 Node.js 运行环境（$NODE_DIR）？(y/N) " KEEP_NODE
  if [ "$KEEP_NODE" = "y" ] || [ "$KEEP_NODE" = "Y" ]; then
    echo -e "${DIM}保留 Node.js 环境: $NODE_DIR${NC}"
    KEEP=1
  else
    echo -e "${CYAN}删除 Node.js 环境: $NODE_DIR${NC}"
    rm -rf "$NODE_DIR"
    KEEP=0
  fi

  echo -e "${CYAN}删除项目文件: $INSTALL_DIR${NC}"
  rm -rf "$INSTALL_DIR"

  echo -e "${CYAN}删除服务文件...${NC}"
  rm -f /etc/systemd/system/${SERVICE_NAME}.service
  rm -f /etc/init.d/${SERVICE_NAME}
  systemctl daemon-reload 2>/dev/null

  if [ "$KEEP" = "0" ]; then
    echo -e "${CYAN}删除管理命令: /usr/local/bin/qxuessh${NC}"
    rm -f /usr/local/bin/qxuessh
  fi

  # 清理临时 swap
  [ -f /tmp/qxue_swap ] && swapoff /tmp/qxue_swap 2>/dev/null && rm -f /tmp/qxue_swap

  echo ""
  echo -e "${GREEN}✓ QxueSSH 已卸载${NC}"
  if [ "$KEEP" = "1" ]; then
    echo -e "${DIM}Node.js 环境已保留，重新安装时可跳过下载${NC}"
    echo -e "${DIM}管理命令 qxuessh 仍可用（重新安装后可继续使用）${NC}"
  fi
  echo ""
  exit 0
}

# ---------- 直接命令模式（兼容旧用法） ----------
cmd_mode() {
  case "$1" in
    status)
      refresh_status
      echo -e "状态: $STATUS_TEXT  端口: ${CYAN}$PORT${NC}  自启: $AUTOSTART_TEXT"
      ;;
    restart)
      case "$SERVICE_MANAGER" in
        systemd) systemctl restart $SERVICE_NAME 2>/dev/null && echo "已重启" ;;
        openrc)  rc-service $SERVICE_NAME restart 2>/dev/null && echo "已重启" ;;
        *) pkill -f "node server.js"; sleep 1; cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 & echo "已重启" ;;
      esac
      ;;
    stop)
      case "$SERVICE_MANAGER" in
        systemd) systemctl stop $SERVICE_NAME 2>/dev/null && echo "已停止" ;;
        openrc)  rc-service $SERVICE_NAME stop 2>/dev/null && echo "已停止" ;;
        *) pkill -f "node server.js" && echo "已停止" ;;
      esac
      ;;
    start)
      case "$SERVICE_MANAGER" in
        systemd) systemctl start $SERVICE_NAME 2>/dev/null && echo "已启动" ;;
        openrc)  rc-service $SERVICE_NAME start 2>/dev/null && echo "已启动" ;;
        *) cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 & echo "已启动" ;;
      esac
      ;;
    port)
      if [ -n "$2" ]; then
        if [ "$SERVICE_MANAGER" = "systemd" ]; then
          sed -i "s/^Environment=PORT=.*/Environment=PORT=$2/" /etc/systemd/system/${SERVICE_NAME}.service
          systemctl daemon-reload; systemctl restart $SERVICE_NAME
        elif [ "$SERVICE_MANAGER" = "openrc" ]; then
          sed -i "s/^env PORT=.*/env PORT=\"$2\"/" /etc/init.d/${SERVICE_NAME}
          rc-service $SERVICE_NAME restart
        fi
        echo "端口已改为 $2"
      else
        echo "用法: qxuessh port <端口号>"
      fi
      ;;
    autostart)
      if [ "$2" = "on" ]; then
        case "$SERVICE_MANAGER" in
          systemd) systemctl enable $SERVICE_NAME && echo "已开启自启动" ;;
          openrc)  rc-update add $SERVICE_NAME default && echo "已开启自启动" ;;
        esac
      elif [ "$2" = "off" ]; then
        case "$SERVICE_MANAGER" in
          systemd) systemctl disable $SERVICE_NAME && echo "已关闭自启动" ;;
          openrc)  rc-update del $SERVICE_NAME default && echo "已关闭自启动" ;;
        esac
      else echo "用法: qxuessh autostart on|off"; fi
      ;;
    resetpass)
      read -rsp "新密码: " P; echo
      read -rsp "确认密码: " P2; echo
      if [ "$P" = "$P2" ] && [ ${#P} -ge 8 ]; then
        cd $INSTALL_DIR && $NODE_BIN -e "
const fs=require('fs'),b=require('bcryptjs');
const db=JSON.parse(fs.readFileSync('$DB_FILE','utf8'));
const a=db.users.find(u=>u.role==='admin');
a.passHash=b.hashSync(process.argv[1],10);
fs.writeFileSync('$DB_FILE',JSON.stringify(db,null,2));
console.log('密码已重置');
" "$P"
      else echo "密码不一致或少于8位"; fi
      ;;
    logs) journalctl -u $SERVICE_NAME -n 50 --no-pager 2>/dev/null || tail -50 /tmp/qxuessh.log ;;
    help|*)
      echo "QxueSSH 服务管理"
      echo ""
      echo "交互式菜单: qxuessh"
      echo "直接命令:   qxuessh <命令>"
      echo ""
      echo "命令: status | restart | stop | start | port <端口> | autostart on|off | resetpass | logs"
      ;;
  esac
}

# ---------- 主入口 ----------
if [ $# -gt 0 ]; then
  cmd_mode "$@"
  exit 0
fi

# 交互式菜单循环
while true; do
  draw_menu
  read -rp "请输入序号 [0-9]: " choice
  case "$choice" in
    1) do_restart ;;
    2) do_stop ;;
    3) do_start ;;
    4) do_port ;;
    5) do_autostart ;;
    6) do_resetpass ;;
    7) do_logs ;;
    8) do_detail ;;
    9) do_uninstall ;;
    0|q|Q)
      clear 2>/dev/null || true
      echo -e "${GREEN}已退出 QxueSSH 管理菜单${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}无效选择，请输入 0-8${NC}"
      sleep 1
      ;;
  esac
done
