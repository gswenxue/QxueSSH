#!/usr/bin/env bash
# ============================================================
# QxueSSH 服务管理工具（交互式菜单）
# 用法: qxuessh          —— 唤起菜单
#       qxuessh <命令>   —— 也支持直接命令（status/port/restart等）
# ============================================================

INSTALL_DIR="/opt/QxueSSH"
SERVICE_NAME="qxuessh"
DB_FILE="$INSTALL_DIR/data/db.json"

# 确保终端环境可用
export TERM=xterm-256color

# 动态获取 node 路径（兼容系统预装 / 手动安装等不同位置）
NODE_BIN=$(which node 2>/dev/null || echo "$NODE_BIN")

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; BLUE=$'\033[0;34m'; BOLD=$'\033[1m'; NC=$'\033[0m'
DIM=$'\033[2m'

# ---------- 状态检测 ----------
get_status() {
  if systemctl is-active --quiet $SERVICE_NAME 2>/dev/null; then
    RUNNING=1
    STATUS_TEXT="${GREEN}● 运行中${NC}"
  elif pgrep -f "node server.js" >/dev/null 2>&1; then
    RUNNING=1
    STATUS_TEXT="${GREEN}● 运行中${NC}"
  else
    RUNNING=0
    STATUS_TEXT="${RED}● 未运行${NC}"
  fi
}

get_port() {
  PORT=$(ss -tlnp 2>/dev/null | grep "node" | awk '{print $4}' | grep -oP '\d+$' | head -1)
  [ -z "$PORT" ] && PORT=$(grep -oP 'Environment=PORT=\K\d+' /etc/systemd/system/${SERVICE_NAME}.service 2>/dev/null)
  [ -z "$PORT" ] && PORT="--"
}

get_autostart() {
  if systemctl is-enabled --quiet $SERVICE_NAME 2>/dev/null; then
    AUTOSTART_TEXT="${GREEN}已开启${NC}"
  else
    AUTOSTART_TEXT="${DIM}未开启${NC}"
  fi
}

refresh_status() {
  get_status
  get_port
  get_autostart
}

# ---------- 可见宽度计算（去掉ANSI码，中文字符算2列） ----------
viswidth() {
  local s=$(echo -n "$1" | sed 's/\x1b\[[0-9;]*m//g')
  local w=0 i c
  for ((i=0; i<${#s}; i++)); do
    c="${s:$i:1}"
    if [[ "$c" =~ [一-鿿] ]]; then w=$((w+2)); else w=$((w+1)); fi
  done
  echo $w
}

# ---------- 菜单绘制（动态边框，确保所有框宽度一致） ----------
MENU_WIDTH=38  # 内容区宽度（不含两侧║）

# 生成指定字符重复n次
repeat_char() {
  local char="$1" count="$2" i
  local result=""
  for ((i=0; i<count; i++)); do result="${result}${char}"; done
  echo -n "$result"
}

# 顶边 ╔═══╗
top_border() { echo -e "${BOLD}${BLUE}╔$(repeat_char "═" $MENU_WIDTH)╗${NC}"; }
# 分隔线 ╠═══╣
mid_border() { echo -e "${BOLD}${BLUE}╠$(repeat_char "═" $MENU_WIDTH)╣${NC}"; }
# 底边 ╚═══╝
bot_border() { echo -e "${BOLD}${BLUE}╚$(repeat_char "═" $MENU_WIDTH)╝${NC}"; }

# 输出一行菜单内容，自动补空格到统一宽度
menuline() {
  local content="$1"
  local vw=$(viswidth "$content")
  local pad=$((MENU_WIDTH - vw))
  [ $pad -lt 0 ] && pad=0
  printf "${BOLD}${BLUE}║${NC}%s%*s${BOLD}${BLUE}║${NC}\n" "$content" "$pad" ""
}

draw_menu() {
  refresh_status
  clear 2>/dev/null || printf '\033[2J\033[H'
  echo ""
  top_border
  menuline "     ${BOLD}QxueSSH 服务管理${NC}"
  mid_border
  menuline "  状态: $STATUS_TEXT"
  menuline "  端口: ${CYAN}$PORT${NC}"
  menuline "  自启: $AUTOSTART_TEXT"
  mid_border
  menuline "  ${DIM}1${NC}. 重启服务"
  menuline "  ${DIM}2${NC}. 停止服务"
  menuline "  ${DIM}3${NC}. 启动服务"
  menuline "  ${DIM}4${NC}. 修改运行端口"
  menuline "  ${DIM}5${NC}. 开机自启动管理"
  menuline "  ${DIM}6${NC}. 重置管理员密码"
  menuline "  ${DIM}7${NC}. 查看运行日志"
  menuline "  ${DIM}8${NC}. 查看服务详情"
  mid_border
  menuline "  ${DIM}0${NC}. 退出"
  bot_border
  echo ""
}

pause() {
  echo ""
  read -rp "按回车键返回菜单..." _
}

# ---------- 操作函数 ----------
do_restart() {
  echo -e "${CYAN}正在重启服务...${NC}"
  if command -v systemctl &>/dev/null; then
    systemctl restart $SERVICE_NAME && echo -e "${GREEN}✓ 服务已重启${NC}"
  else
    pkill -f "node server.js" 2>/dev/null; sleep 1
    cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 &
    echo -e "${GREEN}✓ 服务已重启${NC}"
  fi
  pause
}

do_stop() {
  if [ "$RUNNING" -eq 0 ]; then
    echo -e "${YELLOW}服务当前未运行${NC}"
    pause; return
  fi
  echo -e "${CYAN}正在停止服务...${NC}"
  if command -v systemctl &>/dev/null; then
    systemctl stop $SERVICE_NAME && echo -e "${GREEN}✓ 服务已停止${NC}"
  else
    pkill -f "node server.js" && echo -e "${GREEN}✓ 服务已停止${NC}"
  fi
  pause
}

do_start() {
  if [ "$RUNNING" -eq 1 ]; then
    echo -e "${YELLOW}服务已在运行中${NC}"
    pause; return
  fi
  echo -e "${CYAN}正在启动服务...${NC}"
  if command -v systemctl &>/dev/null; then
    systemctl start $SERVICE_NAME && echo -e "${GREEN}✓ 服务已启动${NC}"
  else
    cd $INSTALL_DIR && nohup $NODE_BIN server.js > /tmp/qxuessh.log 2>&1 &
    echo -e "${GREEN}✓ 服务已启动${NC}"
  fi
  pause
}

do_port() {
  echo ""
  echo -e "${CYAN}当前端口: $PORT${NC}"
  read -rp "请输入新端口号 (1-65535): " NEW_PORT
  if [ -z "$NEW_PORT" ]; then
    echo -e "${RED}✗ 未输入端口，已取消${NC}"; pause; return
  fi
  if ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
    echo -e "${RED}✗ 无效端口号${NC}"; pause; return
  fi
  if command -v systemctl &>/dev/null; then
    sed -i "s/^Environment=PORT=.*/Environment=PORT=$NEW_PORT/" /etc/systemd/system/${SERVICE_NAME}.service
    systemctl daemon-reload
    systemctl restart $SERVICE_NAME
    echo -e "${GREEN}✓ 端口已修改为 $NEW_PORT，服务已重启${NC}"
  else
    echo -e "${YELLOW}未使用 systemd，请手动修改启动命令中的 PORT 环境变量${NC}"
  fi
  pause
}

do_autostart() {
  echo ""
  echo -e "当前自启动状态: $AUTOSTART_TEXT"
  echo ""
  echo "  1. 开启开机自启动"
  echo "  2. 关闭开机自启动"
  echo "  0. 返回"
  read -rp "请选择 [0-2]: " sub
  case "$sub" in
    1) systemctl enable $SERVICE_NAME 2>/dev/null && echo -e "${GREEN}✓ 已开启开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}" ;;
    2) systemctl disable $SERVICE_NAME 2>/dev/null && echo -e "${GREEN}✓ 已关闭开机自启动${NC}" || echo -e "${RED}✗ 操作失败${NC}" ;;
    *) ;;
  esac
  pause
}

do_resetpass() {
  echo ""
  echo -e "${YELLOW}⚠ 重置管理员密码${NC}"
  echo -e "${DIM}将修改数据库中管理员账号的密码哈希${NC}"
  echo ""
  read -rsp "请输入新密码（至少8位）: " NEW_PASS; echo
  if [ ${#NEW_PASS} -lt 8 ]; then
    echo -e "${RED}✗ 密码至少 8 位${NC}"; pause; return
  fi
  read -rsp "请再次输入确认: " NEW_PASS2; echo
  if [ "$NEW_PASS" != "$NEW_PASS2" ]; then
    echo -e "${RED}✗ 两次输入不一致${NC}"; pause; return
  fi
  cd $INSTALL_DIR
  RESULT=$($NODE_BIN -e "
const fs = require('fs');
const b = require('bcryptjs');
try {
  const db = JSON.parse(fs.readFileSync('$DB_FILE', 'utf8'));
  const admin = db.users.find(u => u.role === 'admin');
  if (!admin) { console.log('FAIL:未找到管理员账号'); process.exit(1); }
  admin.passHash = b.hashSync(process.argv[1], 10);
  fs.writeFileSync('$DB_FILE', JSON.stringify(db, null, 2));
  console.log('OK:' + admin.username);
} catch(e) { console.log('FAIL:' + e.message); process.exit(1); }
" "$NEW_PASS" 2>&1)
  if echo "$RESULT" | grep -q "^OK:"; then
    USERNAME=$(echo "$RESULT" | cut -d: -f2)
    echo -e "${GREEN}✓ 管理员「$USERNAME」密码已重置${NC}"
    echo -e "${DIM}请使用新密码登录${NC}"
  else
    echo -e "${RED}✗ 重置失败: $(echo "$RESULT" | cut -d: -f2)${NC}"
  fi
  pause
}

do_logs() {
  echo ""
  echo -e "${CYAN}最近 50 行日志:${NC}"
  echo -e "${DIM}──────────────────────────────────────${NC}"
  if command -v journalctl &>/dev/null; then
    journalctl -u $SERVICE_NAME -n 50 --no-pager 2>/dev/null || echo "无日志"
  else
    tail -50 /tmp/qxuessh.log 2>/dev/null || echo "暂无日志"
  fi
  echo -e "${DIM}──────────────────────────────────────${NC}"
  pause
}

do_detail() {
  echo ""
  if command -v systemctl &>/dev/null; then
    systemctl status $SERVICE_NAME --no-pager -l 2>/dev/null
  else
    echo "进程信息:"
    ps aux | grep "node server.js" | grep -v grep
    echo ""
    echo "监听端口:"
    ss -tlnp | grep node
  fi
  pause
}

# ---------- 直接命令模式（兼容旧用法） ----------
cmd_mode() {
  case "$1" in
    status)
      refresh_status
      echo -e "状态: $STATUS_TEXT  端口: ${CYAN}$PORT${NC}  自启: $AUTOSTART_TEXT"
      ;;
    restart) systemctl restart $SERVICE_NAME 2>/dev/null && echo "已重启" ;;
    stop)    systemctl stop $SERVICE_NAME 2>/dev/null && echo "已停止" ;;
    start)   systemctl start $SERVICE_NAME 2>/dev/null && echo "已启动" ;;
    port)
      if [ -n "$2" ]; then
        sed -i "s/^Environment=PORT=.*/Environment=PORT=$2/" /etc/systemd/system/${SERVICE_NAME}.service
        systemctl daemon-reload; systemctl restart $SERVICE_NAME
        echo "端口已改为 $2"
      else
        echo "用法: qxuessh port <端口号>"
      fi
      ;;
    autostart)
      if [ "$2" = "on" ]; then systemctl enable $SERVICE_NAME && echo "已开启自启动"
      elif [ "$2" = "off" ]; then systemctl disable $SERVICE_NAME && echo "已关闭自启动"
      else echo "用法: qxuessh autostart on|off"; fi
      ;;
    resetpass)
      read -rsp "新密码: " P; echo
      read -rsp "确认密码: " P2; echo
      if [ "$P" = "$P2" ] && [ ${#P} -ge 8 ]; then
        cd $INSTALL_DIR && $NODE_BIN -e "
const fs=require('fs'),b=require('bcryptjs');
const db=JSON.parse(fs.readFileSync('$DB_FILE','utf8'));
const a=db.users.find(u=>u.role==='admin');
a.passHash=b.hashSync(process.argv[1],10);
fs.writeFileSync('$DB_FILE',JSON.stringify(db,null,2));
console.log('密码已重置');
" "$P"
      else echo "密码不一致或少于8位"; fi
      ;;
    logs) journalctl -u $SERVICE_NAME -n 50 --no-pager 2>/dev/null || tail -50 /tmp/qxuessh.log ;;
    help|*)
      echo "QxueSSH 服务管理"
      echo ""
      echo "交互式菜单: qxuessh"
      echo "直接命令:   qxuessh <命令>"
      echo ""
      echo "命令: status | restart | stop | start | port <端口> | autostart on|off | resetpass | logs"
      ;;
  esac
}

# ---------- 主入口 ----------
if [ $# -gt 0 ]; then
  cmd_mode "$@"
  exit 0
fi

# 交互式菜单循环
while true; do
  draw_menu
  read -rp "请输入序号 [0-8]: " choice
  case "$choice" in
    1) do_restart ;;
    2) do_stop ;;
    3) do_start ;;
    4) do_port ;;
    5) do_autostart ;;
    6) do_resetpass ;;
    7) do_logs ;;
    8) do_detail ;;
    0|q|Q)
      clear 2>/dev/null || true
      echo -e "${GREEN}已退出 QxueSSH 管理菜单${NC}"
      exit 0
      ;;
    *)
      echo -e "${RED}无效选择，请输入 0-8${NC}"
      sleep 1
      ;;
  esac
done
